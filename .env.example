# App
DATABASE_URL=

# JWT (paksa ganti di produksi)
JWT_SECRET=

# Kunci enkripsi data sensitif (email/NISN) — minimal 32 karakter, acak di produksi
DATA_KEY=

# Refresh token (hari, default 30)
REFRESH_TOKEN_TTL_DAYS=30

# Server
PORT=3000

# Penyimpanan file S3-compatible (MinIO untuk development / Cloudflare R2 di produksi)
# Cloudflare R2: S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lms-files
PRESIGN_TTL_SECONDS=900

# Batas ukuran berkas (divalidasi server saat presign)
MAX_VIDEO_MB=200
MAX_FILE_MB=20

# Bootstrap admin (dipakai `bun run db:seed`) — jalan sekali, idempoten.
# Tidak membuat akun lain; guru/murid/orang tua dibuat lewat menu Kelola Pengguna.
ADMIN_EMAIL=
ADMIN_PASSWORD=
