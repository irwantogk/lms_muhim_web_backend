    "@elysiajs/swagger": "^1.3.1",
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "jose": "^6.2.10",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "~5.9.0"
  }
}
